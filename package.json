{
  "name": "staf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.27.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "pnpm run build && node dist/cli.js",
    "test": "pnpm run build && node --test test/*.test.js",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist/*.js",
    "src/*.ts",
    "test/*.test.js",
    "test/fixtures/session-v1.json",
    "docs/*.md",
    "tsconfig.json",
    "pnpm-lock.yaml",
    "README.md",
    "AGENTS.md",
    ".env.example",
    "THIRD_PARTY_NOTICES.md"
  ]
}
