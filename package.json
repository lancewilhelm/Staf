{
  "name": "staf",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "engines": {
    "node": ">=22.16.0",
    "pnpm": ">=12.16.1"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "start": "corepack pnpm run build && node dist/cli.js",
    "test": "corepack pnpm run build && node --test test/*.test.js",
    "check": "tsc -p tsconfig.json --noEmit && vue-tsc -p web/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.14"
  },
  "files": [
    "dist/*.js",
    "src/*.ts",
    "test/*.test.js",
    "test/fixtures/session-v1.json",
    "docs/*.md",
    "tsconfig.json",
    "pnpm-lock.yaml",
    "README.md",
    "AGENTS.md",
    ".env.example",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "dist/web/**",
    "web/**",
    "vite.config.ts",
    "dist/code-mode/**",
    "src/code-mode/**",
    "test/fixtures/code-mode-crash.mjs",
    "docs/adr/**",
    "docs/design/code-mode/**",
    "docs/research/code-mode*.md"
  ],
  "bin": {
    "staf": "dist/cli.js"
  },
  "dependencies": {
    "@iarna/toml": "2.2.5",
    "quickjs-emscripten": "0.32.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "vue": "^3.5.44",
    "zod": "4.6.7"
  }
}
