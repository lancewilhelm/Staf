{
  "name": "staf",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.27.0",
  "type": "module",
  "engines": {
    "node": ">=22.16.0",
    "pnpm": ">=10.27.0"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "start": "pnpm run build && node dist/cli.js",
    "test": "pnpm run build && node --test test/*.test.js",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "files": [
    "dist/*.js",
    "src/*.ts",
    "test/*.test.js",
    "test/fixtures/session-v1.json",
    "docs/*.md",
    "tsconfig.json",
    "pnpm-lock.yaml",
    "README.md",
    "AGENTS.md",
    ".env.example",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "dist/web/**",
    "web/**",
    "vite.config.ts"
  ],
  "bin": {
    "staf": "dist/cli.js"
  },
  "dependencies": {
    "@iarna/toml": "2.2.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0"
  }
}
