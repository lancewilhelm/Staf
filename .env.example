# Nonsecret provider/model/API-root defaults can also use /settings or settings commands.
# Shell and .env values override saved defaults; /settings show explains sources.
# Copy values manually to project .env or use shell variables. Do not commit .env.
# Shell variables override .env (including explicitly empty values).
OPENROUTER_API_KEY=
# Supply an actual OpenRouter model ID using --model or STAF_MODEL.
# STAF_MODEL=
# Codex direct requires an explicit account-available model. Fresh setup: start Staf, select Codex in /settings, then choose sign-in.
# Tokens remain in .staf/auth/codex-direct.json, separate from CLI login and this file.
# STAF_CODEX_MODEL=
# LM Studio: choose a model already available on your local server.
# LMSTUDIO_MODEL=
# LMSTUDIO_BASE_URL=http://localhost:1234/v1/
# Leave empty unless your LM Studio server requires authentication.
LMSTUDIO_API_KEY=
# Legacy --live provider only:
# STAF_API_KEY=
# STAF_BASE_URL=https://api.openai.com/v1/

# Optional reasoning efforts, per selected provider; default omits an override.
# OPENROUTER_REASONING_EFFORT=default
# STAF_CODEX_REASONING=default
# Current LM Studio / legacy transports only accept default.
# LMSTUDIO_REASONING_EFFORT=default
# STAF_REASONING_EFFORT=default
