# Staf's shared instance reads these values from its host environment.
# It does not load this file automatically. Export only the values you need
# before starting the instance; restart an existing instance after changes.
# Docker Compose does not forward these variables in the base setup. See
# docs/docker-installation.md for explicit provider overrides and their recovery limits.
# Choose provider, model, and reasoning in the bot profile through /settings.

# OpenRouter keys are managed in global Settings or via the paired CLI.
# The shared instance does not use OPENROUTER_API_KEY from its environment.

# LM Studio API root and optional key:
# LMSTUDIO_BASE_URL=http://localhost:1234/v1/
# LMSTUDIO_API_KEY=

# Generic OpenAI-compatible live API root and required key:
# STAF_BASE_URL=https://api.openai.com/v1/
# STAF_API_KEY=

# ChatGPT uses a separate Staf grant. Start sign-in with /auth chatgpt login;
# do not put OAuth tokens in this file or in chat.
